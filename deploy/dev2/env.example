# Copy to /home/plane/plane.env outside Git, replace all placeholders, chmod 600.
# Use separate fresh hex secrets; matching URL passwords must be URL-encoded.
# Verify approved linux/amd64 image IDs against the deployment manifest before up.
# Use immutable digests or unique version+image-ID tags for offline save/load.
# Compose never pulls, so every referenced image must already be loaded.
PLANE_FRONTEND_IMAGE=plane-dev2/frontend:REPLACE_UNIQUE_BUILD_TAG
PLANE_BACKEND_IMAGE=plane-dev2/backend:REPLACE_UNIQUE_BUILD_TAG
PLANE_SPACE_IMAGE=makeplane/plane-space:v1.4.3@sha256:REPLACE_AMD64_DIGEST
PLANE_ADMIN_IMAGE=makeplane/plane-admin:v1.4.3@sha256:REPLACE_AMD64_DIGEST
PLANE_LIVE_IMAGE=makeplane/plane-live:v1.4.3@sha256:REPLACE_AMD64_DIGEST
PLANE_PROXY_IMAGE=makeplane/plane-proxy:v1.4.3@sha256:REPLACE_AMD64_DIGEST
# Select the current PostgreSQL 15 patch, independent of existing host databases.
PLANE_POSTGRES_IMAGE=postgres:15-alpine@sha256:REPLACE_AMD64_DIGEST
PLANE_REDIS_IMAGE=valkey/valkey:7.2.11-alpine@sha256:REPLACE_AMD64_DIGEST
PLANE_RABBITMQ_IMAGE=rabbitmq:3.13.6-management-alpine@sha256:REPLACE_AMD64_DIGEST
PLANE_MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z@sha256:REPLACE_AMD64_DIGEST

PLANE_DATA_ROOT=/home/plane/data
WEB_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090
APP_DOMAIN=localhost
POSTGRES_USER=plane
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
POSTGRES_DB=plane
DATABASE_URL=postgresql://plane:REPLACE_DATABASE_PASSWORD@plane-db:5432/plane
SECRET_KEY=REPLACE_DJANGO_SECRET
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=REPLACE_MQ_PASSWORD
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:REPLACE_MQ_PASSWORD@plane-mq:5672/plane
AWS_ACCESS_KEY_ID=REPLACE_STORAGE_USER
AWS_SECRET_ACCESS_KEY=REPLACE_STORAGE_PASSWORD
AWS_S3_BUCKET_NAME=uploads
LIVE_SERVER_SECRET_KEY=REPLACE_LIVE_SECRET
FILE_SIZE_LIMIT=5242880
