# Copy to .local/runtime.env, replace every CHANGE_ME, and chmod 600 the file.
APP_RELEASE=v1.4.3
PLANE_FRONTEND_IMAGE=plane-custom/frontend:local
PLANE_BACKEND_IMAGE=plane-custom/backend:local
LISTEN_HTTP_PORT=8090
WEB_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090
APP_DOMAIN=localhost
SITE_ADDRESS=:80
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=plane
DATABASE_URL=postgresql://plane:CHANGE_ME_DATABASE_PASSWORD@plane-db:5432/plane
SECRET_KEY=CHANGE_ME_DJANGO_SECRET
REDIS_URL=redis://plane-redis:6379/
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_MQ_PASSWORD
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:CHANGE_ME_MQ_PASSWORD@plane-mq:5672/plane
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
AWS_ACCESS_KEY_ID=CHANGE_ME_STORAGE_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_STORAGE_PASSWORD
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
LIVE_SERVER_SECRET_KEY=CHANGE_ME_LIVE_SECRET
FILE_SIZE_LIMIT=5242880
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=
